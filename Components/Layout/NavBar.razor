@rendermode InteractiveServer
<div class="navbar_container">
    <div class="logo">
        <a href="/" class="links" @onclick="CloseMenu">
            <img src="assets/icons/icon.svg" alt="Logo" />
        </a>
    </div>

    <button class="menu-toggle" @onclick="ToggleMenu" aria-label="Abrir menú" aria-expanded="@isMenuOpen" aria-controls="primary-nav">
        <span class="material-symbols-outlined">@((isMenuOpen ? "close" : "menu"))</span>
    </button>

    <nav id="primary-nav" class="nav_links @(isMenuOpen ? "open" : string.Empty)">
        <a href="/" class="links" @onclick="CloseMenu">
            <span class="material-symbols-outlined fs-5">home</span>
            Inicio
        </a>
        <a href="/registrations" class="links" @onclick="CloseMenu">
            <span class="material-symbols-outlined fs-5">group</span>
            Inscripciones
        </a>
        <a href="/results" class="links" @onclick="CloseMenu">
            <span class="material-symbols-outlined fs-5">bar_chart</span>
            Resultados
        </a>
    </nav>
</div>

@code {
    private bool isMenuOpen = false;
    private void ToggleMenu() => isMenuOpen = !isMenuOpen;
    private void CloseMenu() => isMenuOpen = false;
}