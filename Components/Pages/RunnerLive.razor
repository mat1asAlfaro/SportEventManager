@page "/live/race/{RaceId:int}/runner/{ParticipantId:int}"
@using SportEventManager.Core
@using SportEventManager.DTOs
@rendermode InteractiveServer
@inject IRaceRepository RaceRepository
@inject IParticipantRepository ParticipantRepository
@inject NavigationManager Navigation

<PageTitle>Carreras En Vivo</PageTitle>

<div class="container-lg px-4 px-sm-5 px-lg-4">

  @* Header *@
  <div
    class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mt-3 mb-4">
    <div>
      <div class="d-flex align-items-center gap-2 mb-2">
        <span class="dot-pulse-w-3 bg-success"></span>
        <h1 class="fs-3 fw-bold text-primary mb-2">Corredor @participantName - Vista Detallada</h1>
      </div>
      <p class="text-secondary mb-0">Dorsal #@bibNumberParticipant • @raceName • @eventName</p>
    </div>
  </div>

  <div class="card shadow-sm mb-4 border-0 live-status-card">
    <div class="card-body">

      <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
          <p class="text-secondary small mb-1">Estado Actual</p>
          <span class="badge bg-success bg-opacity-25 text-success fw-semibold px-3 py-2 fs-6">
            En Carrera
          </span>
        </div>
        <div class="text-end">
          <p class="text-secondary small mb-1">Posición</p>
          <h4 class="fw-bold text-success mb-0">#8</h4>
        </div>
      </div>

      <div class="mt-4">
        <p class="text-secondary small mb-1">Progreso</p>
        <div class="progress rounded-pill" style="height: 10px;">
          <div class="progress-bar bg-success" role="progressbar" style="width: 46.7%;" aria-valuenow="46.7"
            aria-valuemin="0" aria-valuemax="100">
          </div>
        </div>
        <p class="text-end text-success fw-semibold mt-2 mb-0">46.7%</p>
      </div>

    </div>
  </div>


</div>

@code {
  [Parameter] public int RaceId { get; set; }
  [Parameter] public int ParticipantId { get; set; }
  private RaceDTO? currentRace;
  private int bibNumberParticipant;
  private string? raceName;
  private string? eventName;
  private string? participantName;

  protected override async Task OnInitializedAsync()
  {
    currentRace = (await RaceRepository.GetRaceDTOByIdAsync(RaceId));

    var registration = currentRace?.Registrations?
    .FirstOrDefault(rg => rg.ParticipantId == ParticipantId);

    bibNumberParticipant = registration?.BibNumber ?? 0;
    raceName = currentRace!.RaceName;
    eventName = currentRace.EventName;

    var participant = (await ParticipantRepository.GetParticipantByIdAsync(ParticipantId));
    participantName = $"{participant!.FirstName} {participant!.LastName}";
  }
}