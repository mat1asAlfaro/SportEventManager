@page "/events"
@using Microsoft.EntityFrameworkCore.Migrations.Operations
@using Microsoft.IdentityModel.Protocols.OpenIdConnect
@using SportEventManager.Core
@using SportEventManager.Components.Shared
@using SportEventManager.DTOs
@using SportEventManager.Data
@using SportEventManager.Models
@using System.Runtime.InteropServices
@using System.Linq
@using System.Runtime.Versioning
@using System.Timers
@using System.Text
@using System.Globalization
@rendermode InteractiveServer
@inject IEventRepository EventRepository
@inject IRaceRepository RaceRepository
@inject ISplitRepository SplitRepository;
@inject ICategoryRepository CategoryRepository;
@inject IJSRuntime JS

<PageTitle>Eventos</PageTitle>

<div>
  <div class="container-lg px-4 px-sm-5 px-lg-4">

    @* Header *@
    <div
      class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mt-3"
      style="margin-bottom: 32px;">
      <div>
        <h1 class="fs-3 fw-bold text-primary mb-2">Gestión de Eventos</h1>
        <p class="text-secondary mb-0">Administra eventos y sus carreras deportivas</p>
      </div>
      <button class="btn btn-primary btn-lg d-flex align-items-center gap-2 fs-6 fw-semibold"
        @onclick="ShowAddEventModal">
        <span class="material-symbols-outlined">add</span>
        Crear Nuevo Evento
      </button>

      <AddEventModal @ref="addEventModal" OnSave="HandleSaveAddEvent" />
    </div>

    @* Filters *@
    <div class="card shadow-sm mb-4 border-0">
      <div class="card-body">
        <div class="d-flex align-items-center mb-4">
          <span class="material-symbols-outlined me-2 text-secondary fs-5">filter_list</span>
          <h5 class="fw-semibold mb-0">Filtros</h5>
          <button class="btn btn-sm btn-outline-secondary ms-auto" @onclick="ResetFilters" title="Restablecer Filtros">
            <span class="material-symbols-outlined text-secondary fs-5">autorenew</span>
          </button>
        </div>

        <div class="d-flex flex-wrap gap-4 justify-content-between">
          <div class="flex-grow-1" style="min-width: 250px; max-width: 300px;">
            <div class="d-flex flex-column">
              <h6 class="fw-semibold mb-2">Buscar</h6>
              <div class="position-relative">
                <span
                  class="material-symbols-outlined text-secondary position-absolute top-50 translate-middle-y ms-3">search</span>
                <input type="text" class="form-control ps-5 placeholder-white" placeholder="Nombre o ubicación..."
                  value="@searchText" @oninput="OnSearchTextChanged" />
              </div>
            </div>
          </div>
          <div class="flex-grow-1" style="min-width: 250px; max-width: 300px;">
            <div class="position-relative">
              <h6 class="fw-semibold mb-2">Estado</h6>
              <select class="form-select" @bind="selectedStatus" @bind:after="ApplyFilters">
                <option selected>Todos los estados</option>
                <option value="Próximo">Próximos</option>
                <option value="Confirmado">Confirmados</option>
                <option value="Finalizado">Finalizados</option>
              </select>
            </div>
          </div>
          <div class="flex-grow-1" style="min-width: 250px; max-width: 300px;">
            <div class="d-flex flex-column">
              <h6 class="fw-semibold mb-2">Categoría de Carrera</h6>
              <select class="form-select" @bind="selectedCategory" @bind:after="ApplyFilters">
                <option selected>Todas las categorías</option>
                @foreach (var cat in categoryNames)
                {
                  <option>@cat</option>
                }
              </select>
            </div>
          </div>
        </div>

      </div>
    </div>

    @* Stats Cards *@
    <div class="row row-cols-1 row-cols-md-3 g-4 mb-4">
      <div class="col">
        <StatsCard Title="Total Eventos" Value="@(events.Count.ToString() ?? "0")" Description="eventos registrados"
          Icon="calendar_today" IconClass="fs-5" />
      </div>
      <div class="col">
        <StatsCard Title="Total Carreras" Value="@(totalCountRaces.ToString() ?? "0")"
          Description="carreras disponibles" Icon="trophy" IconStyle="Outlined" IconClass="fs-5" />
      </div>
      <div class="col">
        <StatsCard Title="Corredores Totales" Value="@(totalCountParticipants.ToString() ?? "0")"
          Description="inscripciones activas" Icon="group" IconStyle="Outlined" IconClass="fs-5" />
      </div>
    </div>

    <div class="mb-0">
      @* Event Grid *@
      @if (events.Any())
      {
        <div class="row row-cols-1 row-cols-lg-2 g-4">
          @foreach (var ev in events)
          {
            <div class="col">
              <EventCard Event="ev" OnEdit=" HandleEditEvent" OnDelete="HandleDeleteEvent" OnAddRace="HandleAddRace"
                OnAddSplit="HandleAddSplit" OnDeleteSplit="HandleDeleteSplitAsync" OnEditRace="HandleEditRace"
                OnDeleteRace="HandleDeleteRace" />
            </div>
          }
        </div>
      }
      else
      {
        <div class="text-center text-secondary py-5">
          No hay eventos registrados.
        </div>
      }
    </div>

    @* Modals *@
    <EditEventModal @ref="editEventModal" OnSave="HandleSaveEditEvent" />
    <GenericConfirmModal @ref="deleteEventModal" Title="Confirmar Eliminación" ConfirmButtonText="Eliminar"
      ConfirmButtonClass="btn-danger" OnConfirm="@ConfirmDeleteEvent">
      <p>¿Estás seguro de que deseas eliminar el evento <strong>@selectedEventName</strong>? Esta acción no se puede
        deshacer.
      </p>
    </GenericConfirmModal>
    <AddRaceModal @ref="addRaceModal" OnSave="HandleSaveAddRace" />
    <AddSplitModal @ref="addSplitModal" OnSave="HandleSaveAddSplit" OnDelete="HandleDeleteSplit" />
    <EditRaceModal @ref="editRaceModal" OnSave="HandleSaveEditRace" />
    <GenericConfirmModal @ref="deleteRaceModal" Title="Confirmar Eliminación" ConfirmButtonText="Eliminar"
      ConfirmButtonClass="btn-danger" OnConfirm="ConfirmDeleteRace">
      <p>¿Estás seguro de que deseas eliminar la carrera <strong>@selectedRaceName</strong>? Esta acción no se puede
        deshacer.</p>
    </GenericConfirmModal>
  </div>
</div>

@code {
  private AddEventModal? addEventModal;
  private List<EventDTO> events = new();
  private List<string> categoryNames = new();
  private int totalCountRaces;
  private int totalCountParticipants;
  private EditEventModal? editEventModal;
  private GenericConfirmModal? deleteEventModal;
  private AddSplitModal? addSplitModal;
  private AddRaceModal? addRaceModal;
  private EditRaceModal? editRaceModal;
  private GenericConfirmModal? deleteRaceModal;
  private string selectedEventName = string.Empty;
  private int selectedEventId;
  private string selectedRaceName = string.Empty;
  private int selectedRaceId;
  private int selectedEventIdForRace;
  private List<EventDTO> eventsOriginal = new();
  private string searchText = string.Empty;
  private string selectedStatus = "Todos los estados";
  private string selectedCategory = "Todas las categorías";
  private Timer? searchTimer;

  protected override async Task OnInitializedAsync()
  {
    events = (await EventRepository.GetAllEventsWithRacesAndSplitsAsync()).ToList();
    eventsOriginal = new List<EventDTO>(events);

    totalCountRaces = events.Sum(e => e.Races.Count);
    totalCountParticipants = events.Sum(e => e.TotalParticipantsRegistration);

    var categories = (await CategoryRepository.GetAllCategoriesAsync()).ToList();
    categoryNames = categories.Select(c => c.ExternalName!).ToList();
  }

  private void ShowAddEventModal()
  {
    addEventModal?.Show();
  }

  private async Task HandleSaveAddEvent(Models.Event newEvent)
  {
    await EventRepository.AddEventAsync(newEvent);
    events = (await EventRepository.GetAllEventsWithRacesAndSplitsAsync()).ToList();
    totalCountRaces = events.Sum(e => e.Races.Count);
    totalCountParticipants = events.Sum(e => e.TotalParticipantsRegistration);
    StateHasChanged();
  }

  private void HandleEditEvent(int eventId)
  {
    var ev = events.FirstOrDefault(e => e.EventId == eventId);
    if (ev != null)
      editEventModal?.Show(ev);
  }

  private async Task HandleSaveEditEvent(Models.Event updatedEvent)
  {
    await EventRepository.UpdateEventAsync(updatedEvent);

    var existing = events.FirstOrDefault(e => e.EventId == updatedEvent.EventId);
    if (existing != null)
    {
      existing.Name = updatedEvent.Name;
      existing.Description = updatedEvent.Description;
      existing.StartDate = updatedEvent.StartDate;
      existing.EndDate = updatedEvent.EndDate;
      existing.Location = updatedEvent.Location;
    }

    StateHasChanged();
  }

  private void HandleDeleteEvent(int eventId)
  {
    var ev = events.FirstOrDefault(e => e.EventId == eventId);
    if (ev != null)
    {
      selectedEventId = ev.EventId;
      selectedEventName = ev.Name ?? "evento";
      deleteEventModal?.Show(selectedEventId, selectedEventName);
    }
  }

  private async Task ConfirmDeleteEvent()
  {
    await EventRepository.DeleteEventAsync(selectedEventId);

    var ev = events.FirstOrDefault(e => e.EventId == selectedEventId);
    if (ev != null)
      events.Remove(ev);

    totalCountRaces = events.Sum(e => e.Races.Count);
    totalCountParticipants = events.Sum(e => e.TotalParticipantsRegistration);

    StateHasChanged();
  }

  private void HandleAddRace(int eventId)
  {
    addRaceModal?.Show(eventId);
  }

  private async Task HandleSaveAddRace(Race newRace)
  {
    await RaceRepository.AddRaceAsync(newRace);
    events = (await EventRepository.GetAllEventsWithRacesAndSplitsAsync()).ToList();
    totalCountRaces = events.Sum(e => e.Races.Count);
    totalCountParticipants = events.Sum(e => e.TotalParticipantsRegistration);
    StateHasChanged();
  }

  private void HandleAddSplit((int EventId, int RaceId) data)
  {
    var ev = events.FirstOrDefault(e => e.EventId == data.EventId);
    var race = ev?.Races.FirstOrDefault(r => r.RaceId == data.RaceId);

    if (race != null)
    {
      if (race.Splits != null)
      {
        race.Splits = race.Splits.OrderBy(s => s.KmMark).ToList();
        addSplitModal?.Show(race);
      }
    }
  }

  private async Task HandleSaveAddSplit(Split newSplit)
  {
    await SplitRepository.AddSplitAsync(newSplit);

    events = (await EventRepository.GetAllEventsWithRacesAndSplitsAsync()).ToList();
    var ev = events.FirstOrDefault(e => e.Races.Any(r => r.RaceId == newSplit.RaceId));
    var race = ev?.Races.FirstOrDefault(r => r.RaceId == newSplit.RaceId);

    if (race != null)
      addSplitModal?.Show(race);

    StateHasChanged();
  }

  private async Task HandleDeleteSplit(int splitId)
  {
    await SplitRepository.DeleteSplitAsync(splitId);
    events = (await EventRepository.GetAllEventsWithRacesAndSplitsAsync()).ToList();
    StateHasChanged();
  }

  private async Task HandleDeleteSplitAsync((int RaceId, int SplitId) data)
  {
    await SplitRepository.DeleteSplitAsync(data.SplitId);

    var race = events.SelectMany(e => e.Races)
    .FirstOrDefault(r => r.RaceId == data.RaceId);

    if (race != null && race.Splits != null)
    {
      var split = race.Splits.FirstOrDefault(s => s.SplitId == data.SplitId);
      if (split != null)
        race.Splits.Remove(split);
    }

    StateHasChanged();
  }

  private void HandleEditRace((int EventId, int RaceId) data)
  {
    var ev = events.FirstOrDefault(e => e.EventId == data.EventId);
    var race = ev!.Races.FirstOrDefault(r => r.RaceId == data.RaceId);

    if (race != null)
      editRaceModal?.Show(race.RaceId);
  }

  private async Task HandleSaveEditRace(Race updatedRace)
  {
    await RaceRepository.UpdateRaceAsync(updatedRace);
    events = (await EventRepository.GetAllEventsWithRacesAndSplitsAsync()).ToList();

    totalCountRaces = events.Sum(e => e.Races.Count);
    totalCountParticipants = events.Sum(e => e.TotalParticipantsRegistration);

    StateHasChanged();
  }

  private void HandleDeleteRace((int EventId, int RaceId) data)
  {
    selectedEventIdForRace = data.EventId;
    selectedRaceId = data.RaceId;

    var ev = events.FirstOrDefault(e => e.EventId == data.EventId);
    var race = ev?.Races.FirstOrDefault(r => r.RaceId == data.RaceId);
    selectedRaceName = race?.Name ?? string.Empty;

    deleteRaceModal?.Show(selectedRaceId, selectedRaceName);
  }

  private async Task ConfirmDeleteRace()
  {
    await RaceRepository.DeleteRaceAsync(selectedRaceId);

    var ev = events.FirstOrDefault(e => e.EventId == selectedEventIdForRace);
    if (ev != null)
    {
      var raceToRemove = ev.Races.FirstOrDefault(r => r.RaceId == selectedRaceId);
      if (raceToRemove != null)
        ev.Races.Remove(raceToRemove);
    }

    totalCountRaces = events.Sum(e => e.Races.Count);
    totalCountParticipants = events.Sum(e => e.TotalParticipantsRegistration);

    StateHasChanged();
  }

  private void ApplyFilters()
  {
    var filtered = eventsOriginal;

    if (!string.IsNullOrWhiteSpace(searchText))
    {
      var text = searchText.Trim().ToLower();

      text = RemoveDiacritics(text);

      filtered = filtered.Where(e =>
      (!string.IsNullOrEmpty(e.Name) && RemoveDiacritics(e.Name.ToLower()).Contains(text)) ||
      (!string.IsNullOrEmpty(e.Location) && RemoveDiacritics(e.Location.ToLower()).Contains(text))
      ).ToList();
    }

    if (selectedStatus != "Todos los estados")
    {
      var normalizedStatus = RemoveDiacritics(selectedStatus.ToLower());
      filtered = filtered.Where(e => RemoveDiacritics(e.StatusLabel.ToLower()) == normalizedStatus).ToList();
    }

    if (selectedCategory != "Todas las categorías")
    {
      var normalizedCategory = RemoveDiacritics(selectedCategory.ToLower());
      filtered = filtered.Where(e => e.Races.Any(r =>
      r.RaceCategories!.Any(rc => RemoveDiacritics(rc.Category!.ExternalName!.ToLower()) == normalizedCategory)
      )).ToList();
    }

    events = filtered;
    StateHasChanged();
  }

  private void ResetFilters()
  {
    searchText = string.Empty;
    selectedStatus = "Todos los estados";
    selectedCategory = "Todas las categorías";
    events = new List<EventDTO>(eventsOriginal);
  }

  private void OnSearchTextChanged(ChangeEventArgs e)
  {
    searchText = e.Value?.ToString() ?? string.Empty;

    searchTimer?.Stop();
    searchTimer?.Dispose();

    searchTimer = new Timer(1000);
    searchTimer.Elapsed += async (s, _) =>
    {
      searchTimer?.Stop();
      searchTimer?.Dispose();

      await InvokeAsync(() => ApplyFilters());
    };
    searchTimer.AutoReset = false;
    searchTimer.Start();
  }

  private void OnFilterChanged(ChangeEventArgs e)
  {
    ApplyFilters();
  }

  public static string RemoveDiacritics(string text)
  {
    var normalizedString = text.Normalize(NormalizationForm.FormD);
    var stringBuilder = new System.Text.StringBuilder();

    foreach (var character in normalizedString)
    {
      if (CharUnicodeInfo.GetUnicodeCategory(character) != UnicodeCategory.NonSpacingMark)
      {
        stringBuilder.Append(character);
      }
    }

    return stringBuilder.ToString().Normalize(NormalizationForm.FormC);
  }
}