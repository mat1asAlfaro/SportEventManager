@page "/finish-line/{RaceId:int}"
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.EntityFrameworkCore
@using SportEventManager.Core
@using SportEventManager.DTOs
@using SportEventManager.Data.Persistence
@rendermode InteractiveServer
@inject NavigationManager Navigation
@inject IRaceRepository RaceRepository
@inject IDbContextFactory<SportEventDbContext> DbContextFactory
@inject ISplitRepository SplitRepository
@inject IRegistrationRepository RegistrationRepository
@implements IAsyncDisposable

<PageTitle>Pantalla de Meta</PageTitle>

<div class="finish-line-screen">
    @if (_isLoading)
    {
        <div class="d-flex flex-column justify-content-center align-items-center text-light">
            <div class="spinner-border spinner-xl" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <p class="mt-4 fs-4">Preparando pantalla de meta...</p>
        </div>
    }
    else if (_hasError)
    {
        <div class="d-flex flex-column justify-content-center align-items-center text-light">
            <span class="material-symbols-outlined text-danger mb-3 icon-error">error</span>
            <h2 class="text-danger mb-3">Error</h2>
            <p class="mb-4">@_errorMessage</p>
            <button class="btn btn-light btn-lg d-inline-flex align-items-center gap-2" @onclick="LoadData">
                <span class="material-symbols-outlined">refresh</span>
                Reintentar
            </button>
        </div>
    }
    else
    {
        <div class="meta-container w-100 text-center">
            <div class="mb-4 mb-md-5">
                <h1 class="race-name text-uppercase fw-bold text-light mb-0">@_raceName</h1>
            </div>

            @if (_timerVisible)
            {
                <div class="main-timer fw-bold font-monospace mb-4 mb-md-5 @(_isCountdown ? "text-warning" : "")">
                    @_elapsedRaceTime
                </div>
            }

            @if (_lastApproachingRunner != null)
            {
                <div class="current-runner mb-4 mb-md-5">
                    <div class="runner-name text-uppercase fw-bold text-light mb-3">@_lastApproachingRunner.ParticipantName
                    </div>
                    <div class="runner-bib fw-bold text-primary">
                        # @_lastApproachingRunner.BibNumber
                    </div>
                </div>
            }
            else
            {
                <div class="waiting-state my-4 my-md-5">
                    <span class="material-symbols-outlined waiting-icon text-light mb-3 d-block">timer</span>
                    <p class="text-secondary fs-4 mb-0">Esperando corredores...</p>
                </div>
            }

            @if (_finishers.Count > 0)
            {
                <div class="previous-runners mt-4 mt-md-5 mx-auto">
                    @foreach (var finisher in _finishers.OrderByDescending(f => f.Timestamp).Take(3))
                    {
                        <div class="card bg-dark border-secondary mb-3">
                            <div
                                class="card-body d-flex flex-column flex-md-row align-items-center justify-content-between gap-3 py-3 px-4">
                                <div class="d-flex flex-column flex-md-row align-items-center gap-2 gap-md-3 flex-grow-1">
                                    <span
                                        class="fw-semibold text-light text-truncate runner-name-small">@finisher.ParticipantName</span>
                                    <span class="fw-bold text-primary runner-bib-small">
                                        # @finisher.BibNumber
                                    </span>
                                </div>
                                <div class="fw-bold text-secondary font-monospace runner-time">@finisher.ElapsedTime</div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public int RaceId { get; set; }

    private HubConnection? _hubConnection;
    private bool _isLoading = true;
    private bool _hasError = false;
    private string _errorMessage = "";
    private System.Threading.Timer? _raceTimer;
    private bool _disposed = false;

    private string? _raceName;
    private DateTime? _raceStartTime;
    private int? _prefinishSplitId;
    private int? _finishSplitId;
    private string _elapsedRaceTime = "00:00:00";
    private bool _timerVisible = false;
    private bool _isCountdown = false;

    private List<FinisherData> _finishers = new();
    private FinisherData? _lastApproachingRunner;

    protected override async Task OnInitializedAsync()
    {
        await InitializeRace();
    }

    protected override async Task OnParametersSetAsync()
    {
        await CleanupResources();
        await InitializeRace();
    }

    private async Task InitializeRace()
    {
        await LoadData();
        if (!_hasError)
        {
            StartRaceTimer();
            await ConnectToSignalR();
        }
    }

    private async Task CleanupResources()
    {
        if (_raceTimer != null)
        {
            await _raceTimer.DisposeAsync();
            _raceTimer = null;
        }

        if (_hubConnection is not null)
        {
            try
            {
                await _hubConnection.StopAsync();
                await _hubConnection.DisposeAsync();
                _hubConnection = null;
            }
            catch { }
        }
    }

    private void StartRaceTimer()
    {
        _raceTimer = new System.Threading.Timer(async _ =>
        {
            if (_disposed) return;

            if (_raceStartTime.HasValue)
            {
                var now = DateTime.Now;
                var startTime = _raceStartTime.Value;
                var maxDuration = TimeSpan.FromHours(24);

                // Si la carrera ha estado en curso por demasiado tiempo, detener el temporizador
                if (now - startTime > maxDuration)
                {
                    if (_raceTimer != null)
                    {
                        await _raceTimer.DisposeAsync();
                        _raceTimer = null;
                    }
                    return;
                }

                // 1. No es hoy -> Ocultar
                if (startTime.Date != now.Date)
                {
                    _timerVisible = false;
                }
                //2. Hoy > 1 hora -> Ocultar
                else if (startTime > now.AddHours(1))
                {
                    _timerVisible = false;
                }
                // 3. Contador regresivo (< 1 hora)
                else if (startTime > now)
                {
                    var remaining = startTime - now;
                    _elapsedRaceTime = $"{remaining:hh\\:mm\\:ss}";
                    _timerVisible = true;
                    _isCountdown = true;
                }
                // 4. Tiempo transcurrido (Iniciada)
                else
                {
                    var elapsed = now - startTime;
                    _elapsedRaceTime = $"{elapsed:hh\\:mm\\:ss}";
                    _timerVisible = true;
                    _isCountdown = false;
                }

                try
                {
                    await InvokeAsync(StateHasChanged);
                }
                catch (ObjectDisposedException)
                {
                    _raceTimer?.Dispose();
                }
            }
        }, null, TimeSpan.Zero, TimeSpan.FromSeconds(1));
    }

    private async Task LoadData()
    {
        try
        {
            _isLoading = true;
            _hasError = false;

            var race = await RaceRepository.GetRaceDTOByIdAsync(RaceId);
            if (race == null)
            {
                _hasError = true;
                _errorMessage = "No se encontró la carrera.";
                return;
            }

            _raceName = race.RaceName;
            _raceStartTime = race.StartTime;

            var splits = race.Splits?.OrderBy(s => s.KmMark).ToList();
            if (splits == null || splits.Count < 2)
            {
                _hasError = true;
                _errorMessage = "La carrera debe tener al menos 2 puntos de control (inicio y meta).";
                return;
            }

            _finishSplitId = splits.Last().SplitId;
            _prefinishSplitId = splits[splits.Count - 2].SplitId;

            await LoadExistingFinishers(race);

            _isLoading = false;
        }
        catch
        {
            _hasError = true;
            _errorMessage = "Error al cargar los datos de la carrera.";
            _isLoading = false;
        }
    }

    private async Task LoadExistingFinishers(RaceDTO race)
    {
        if (_finishSplitId == null || _raceStartTime == null) return;

        _finishers.Clear();

        var finishRecords = race.TimeRecords?
        .Where(tr => tr.SplitId == _finishSplitId.Value)
        .OrderBy(tr => tr.Timestamp)
        .ToList() ?? new List<TimeRecordResponseDTO>();

        foreach (var timeRecord in finishRecords)
        {
            var registration = race.Registrations?.FirstOrDefault(r =>
            r.RegistrationChips?.Any(rc => rc.ChipId == timeRecord.ChipId) ?? false);

            if (registration == null) continue;

            var participantName = registration.ParticipantName ?? $"Participante #{registration.ParticipantId}";

            var elapsedTime = CalculateElapsedString(timeRecord.Timestamp);

            _finishers.Add(new FinisherData
            {
                BibNumber = registration.BibNumber ?? 0,
                ParticipantName = participantName,
                ElapsedTime = elapsedTime,
                Timestamp = timeRecord.Timestamp
            });
        }

        if (_prefinishSplitId != null)
        {
            var prefinishRecord = race.TimeRecords?
            .Where(tr => tr.SplitId == _prefinishSplitId.Value)
            .OrderByDescending(tr => tr.Timestamp)
            .FirstOrDefault();

            if (prefinishRecord != null)
            {
                var registration = race.Registrations?.FirstOrDefault(r =>
                r.RegistrationChips?.Any(rc => rc.ChipId == prefinishRecord.ChipId) ?? false);

                if (registration != null)
                {
                    _lastApproachingRunner = new FinisherData
                    {
                        BibNumber = registration.BibNumber ?? 0,
                        ParticipantName = registration.ParticipantName ?? "",
                        ElapsedTime = "",
                        Timestamp = prefinishRecord.Timestamp
                    };
                }
            }
        }
    }

    private string CalculateElapsedString(DateTime timestampUtc)
    {
        if (!_raceStartTime.HasValue) return "00:00:00";

        var utcTime = timestampUtc.Kind == DateTimeKind.Unspecified
        ? DateTime.SpecifyKind(timestampUtc, DateTimeKind.Utc)
        : timestampUtc;

        var localTime = utcTime.ToLocalTime();
        var elapsed = localTime - _raceStartTime.Value;

        return $"{elapsed:hh\\:mm\\:ss}";
    }

    private async Task ConnectToSignalR()
    {
        try
        {
            _hubConnection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/timingHub"))
            .WithAutomaticReconnect()
            .Build();

            _hubConnection.On<LiveTimeUpdateDTO>("ReceiveTimeUpdate", async (update) =>
            {
                if (_disposed) return;

                if (update.RaceId == RaceId)
                {
                    if (update.SplitId == _prefinishSplitId)
                    {
                        await HandleApproachingRunner(update);
                    }
                    // Handle Finisher (Final Split)
                    else if (update.SplitId == _finishSplitId)
                    {
                        await HandleFinisher(update);
                    }
                }
            });

            _hubConnection.Reconnected += async (connectionId) =>
            {
                if (_disposed) return;
                await SubscribeToSplits();
            };

            await _hubConnection.StartAsync();
            await SubscribeToSplits();
        }
        catch { }
    }

    private async Task SubscribeToSplits()
    {
        var hub = _hubConnection ?? throw new InvalidOperationException("Hub connection not initialized");

        await hub.SendAsync("SubscribeToRace", RaceId);

        if (_prefinishSplitId.HasValue)
            await hub.SendAsync("SubscribeToSplit", _prefinishSplitId.Value);

        if (_finishSplitId.HasValue)
            await hub.SendAsync("SubscribeToSplit", _finishSplitId.Value);
    }


    private async Task HandleApproachingRunner(LiveTimeUpdateDTO update)
    {
        var info = await GetParticipantInfo(update.ChipId, update.SplitId, update.Timestamp);

        _lastApproachingRunner = new FinisherData
        {
            BibNumber = info.BibNumber,
            ParticipantName = info.ParticipantName,
            ElapsedTime = "",
            Timestamp = update.Timestamp
        };

        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleFinisher(LiveTimeUpdateDTO update)
    {
        var info = await GetParticipantInfo(update.ChipId, update.SplitId, update.Timestamp);
        var elapsedTime = CalculateElapsedString(update.Timestamp);

        var newFinisher = new FinisherData
        {
            BibNumber = info.BibNumber,
            ParticipantName = info.ParticipantName,
            ElapsedTime = elapsedTime,
            Timestamp = update.Timestamp
        };

        _finishers.Add(newFinisher);

        await InvokeAsync(StateHasChanged);
    }

    private async Task<(int BibNumber, string ParticipantName)> GetParticipantInfo(int chipId, int splitId, DateTime
    timestamp)
    {
        int bibNumber = 0;
        string participantName = "Corredor";
        int actualChipId = chipId;

        try
        {
            await using var context = DbContextFactory.CreateDbContext();

            if (actualChipId == 0)
            {
                var latestRecord = await context.TimeRecords
                .Where(tr => tr.RaceId == RaceId &&
                tr.SplitId == splitId &&
                tr.Timestamp == timestamp)
                .OrderByDescending(tr => tr.TimeRecordId)
                .Select(tr => tr.ChipId)
                .FirstOrDefaultAsync();

                if (latestRecord > 0)
                {
                    actualChipId = latestRecord;
                }
            }

            if (actualChipId > 0)
            {
                var regInfo = await (from rc in context.RegistrationChips
                                     join r in context.Registrations on rc.RegistrationId equals r.RegistrationId
                                     join p in context.Participants on r.ParticipantId equals p.ParticipantId
                                     where rc.ChipId == actualChipId && r.RaceId == RaceId
                                     select new
                                     {
                                         r.BibNumber,
                                         ParticipantName = (p.FirstName + " " + p.LastName).Trim()
                                     }).FirstOrDefaultAsync();

                if (regInfo != null)
                {
                    bibNumber = regInfo.BibNumber ?? 0;
                    participantName = regInfo.ParticipantName;
                }
            }
        }
        catch { }

        return (bibNumber, participantName);
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;

        if (_raceTimer != null)
        {
            await _raceTimer.DisposeAsync();
            _raceTimer = null;
        }

        if (_hubConnection is not null)
        {
            try
            {
                await _hubConnection.SendAsync("UnsubscribeFromRace", RaceId);
                if (_prefinishSplitId.HasValue)
                    await _hubConnection.SendAsync("UnsubscribeFromSplit", _prefinishSplitId.Value);
                if (_finishSplitId.HasValue)
                    await _hubConnection.SendAsync("UnsubscribeFromSplit", _finishSplitId.Value);

                await _hubConnection.StopAsync();
                await _hubConnection.DisposeAsync();
            }
            catch { }
        }
    }

    private class FinisherData
    {
        public int BibNumber { get; set; }
        public string ParticipantName { get; set; } = "";
        public string ElapsedTime { get; set; } = "";
        public DateTime Timestamp { get; set; }
    }
}