@page "/rankings/leaderboard/{RaceId:int}"
@using Radzen
@using Radzen.Blazor
@using SportEventManager.Core
@using SportEventManager.DTOs
@using SportEventManager.Models
@using SportEventManager.Core.Services
@using System.Linq
@rendermode InteractiveServer
@inject NavigationManager Navigation
@inject IRaceRepository RaceRepository
@inject IRegistrationRepository RegistrationRepository
@inject ISplitRepository SplitRepository
@inject ITimeRecordRepository TimeRecordRepository
@inject ITimingCalculationsService TimingService

<PageTitle>Leaderboard</PageTitle>

<div class="container-lg px-4 px-sm-5 px-lg-4">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mt-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="material-symbols-outlined text-primary fs-3">social_leaderboard</span>
                <h1 class="fs-3 fw-bold text-primary mb-2">Leaderboard</h1>
            </div>
            <p class="text-secondary mb-0">Resultados finales de la carrera</p>
        </div>
        <button class="btn btn-secondary btn-lg d-flex align-items-center gap-2 bg-transparent border fs-6 fw-semibold" @onclick="GoBack">
            <span class="material-symbols-outlined fs-5">keyboard_return</span>
            Volver a rankings
        </button>
    </div>

    @if (_isLoading) {
        <div class="card shadow-sm mb-4 border-0">
            <div class="card-body text-center py-5">
                <div class="spinner-border text-primary slow-spinner leaderboard-spinner" role="status">
                    <span class="visualmente-hidden">Cargando...</span>
                </div>
                <p class="mt-3 text-secondary">Cargando leaderboard...</p>
            </div>
        </div>
    } else if (_errorMessage is not null) {
        <div class="card shadow-sm mb-4 border-0">
            <div class="card-body text-center py-5">
                <span class="material-symbols-outlined mb-3 text-danger error-icon">error</span>
                <h3 class="fw-bold mb-2 text-primary">Error</h3>
                <p class="text-secondary mb-4">@_errorMessage</p>
                <button class="btn btn-primary d-inline-flex align-items-center gap-2" @onclick="Reload">
                    <span class="material-symbols-outlined">refresh</span>
                    <span>Reintentar</span>
                </button>
            </div>
        </div>
    } else if (_notFound) {
        <div class="card shadow-sm mb-4 border-0">
            <div class="card-body text-center py-5">
                <span class="material-symbols-outlined mb-3 text-warning notfound-icon">search_off</span>
                <h3 class="fw-bold mb-2 text-primary">Carrera no encontrada</h3>
                <p class="text-secondary mb-4">No se pudo cargar la información de la carrera.</p>
                <button class="btn btn-primary d-inline-flex align-items-center gap-2" @onclick="GoBack">
                    <span class="material-symbols-outlined">arrow_back</span>
                    <span>Volver</span>
                </button>
            </div>
        </div>
    } else {
        <div class="card shadow-sm mb-4 border-0">
            <div class="card-body d-flex align-items-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-2">
                    <span class="material-symbols-outlined fs-4 text-secondary">emoji_events</span>
                    <div>
                        <div class="fw-semibold">@_eventName</div>
                        <small class="text-secondary">@_raceName - @_raceDate</small>
                    </div>
                </div>
                <div class="text-secondary small d-flex flex-column align-items-end">
                    <div class="d-flex align-items-center gap-1">
                        <span class="material-symbols-outlined">straighten</span>
                        <span>Distancia: @_distanceKm km</span>
                    </div>
                    <div class="d-flex align-items-center gap-1">
                        <span class="material-symbols-outlined">flag</span>
                        <span>Puntos de control: @_splitCount</span>
                    </div>
                    <div class="d-flex align-items-center gap-1">
                        <span class="material-symbols-outlined">group</span>
                        <span>Total de inscriptos: @_regCount</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm mb-4 border-0">
            <div class="card-header border-bottom-0 pb-0 d-flex align-items-center justify-content-between flex-wrap gap-2">
                <div class="d-flex align-items-center gap-3 text-secondary small">
                    <div class="d-flex align-items-center gap-1"><span class="material-symbols-outlined">timer</span><span>Pasajes por puntos de control: @_recordCount</span></div>
                    <div class="d-flex align-items-center gap-1"><span class="material-symbols-outlined">trophy</span><span>Finalizados: @filteredEntries.Count</span></div>
                </div>
                <div class="leaderboard-search">
                    <span class="material-symbols-outlined me-2">search</span>
                    <input class="form-control form-control-sm" @bind="searchText" @bind:event="oninput" placeholder="Buscar por nombre, dorsal o categoría" />
                </div>
            </div>
            <div class="card-body">
                <RadzenDataGrid Data="@filteredEntries" TItem="LeaderboardEntry"
                                AllowPaging="true" PageSize="20" PageSizeOptions="@_pageSizes" ShowPagingSummary="true"
                                AllowAlternatingRows="true" AllowColumnResize="true" AllowColumnPicking="false"
                                SelectionMode="DataGridSelectionMode.Single" @bind-SelectedItem="selectedEntry"
                                Class="leaderboard-grid rz-grid rz-data-grid" RowRender="OnRowRender"
                                Responsive="true" GridLines="DataGridGridLines.None" Style="min-width:100%;">
                    <Columns>
                        <RadzenDataGridColumn TItem="LeaderboardEntry" Title="Pos." Width="90px">
                            <Template Context="e">
                                <div class="d-flex align-items-center gap-2 lb-cell-pos">
                                    @if (e.Position <= 3)
                                    {
                                        <span class="material-symbols-outlined @(GetTrophyClass(e.Position))">emoji_events</span>
                                    }
                                    <span class="fw-semibold">@e.Position@("°")</span>
                                </div>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="LeaderboardEntry" Title="Dorsal" Width="90px">
                            <Template Context="e"><span class="lb-cell">@((e.BibNumber.HasValue ? "#" + e.BibNumber : "-"))</span></Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="LeaderboardEntry" Title="Participante" Width="240px">
                            <Template Context="e">
                                <div class="lb-cell">
                                    @if (e.ParticipantId.HasValue && e.BibNumber.HasValue)
                                    {
                                        <RadzenLink Path="@($"/rankings/bib/{RaceId}/{e.BibNumber}")" Class="fw-semibold lb-link">@e.ParticipantName</RadzenLink>
                                    }
                                    else
                                    {
                                        <span class="fw-semibold">@e.ParticipantName</span>
                                    }
                                </div>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="LeaderboardEntry" Title="Categoría" Width="180px" Property="CategoryName" />
                        <RadzenDataGridColumn TItem="LeaderboardEntry" Title="Tiempo Total" Width="140px">
                            <Template Context="e"><span class="lb-cell">@e.TotalTimeFormatted</span></Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="LeaderboardEntry" Title="Ritmo Promedio" Width="150px">
                            <Template Context="e"><span class="lb-cell">@e.AveragePaceFormatted</span></Template>
                        </RadzenDataGridColumn>
                    </Columns>
                    <EmptyTemplate>
                        @if (_raceStarted) {
                            <div class="d-flex flex-column justify-content-center align-items-center py-5 text-center w-100">
                                <span class="material-symbols-outlined text-secondary fs-1 mb-2">leaderboard</span>
                                <h6 class="fw-semibold text-secondary mb-1">Sin finalizados</h6>
                                <p class="small mb-0">Aún no hay participantes finalizados para esta carrera.</p>
                            </div>
                        } else {
                            <div class="d-flex flex-column justify-content-center align-items-center py-5 text-center w-100">
                                <span class="material-symbols-outlined text-secondary fs-1 mb-2">schedule</span>
                                <h6 class="fw-semibold text-secondary mb-1">Carrera pendiente de inicio</h6>
                                <p class="small mb-1">La carrera aún no ha comenzado.</p>
                                <p class="small mb-0">Inicio programado: @_raceDate</p>
                            </div>
                        }
                    </EmptyTemplate>
                </RadzenDataGrid>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int RaceId { get; set; }
    private int[] _pageSizes = new[] {10,20,50};

    private bool _isLoading = true;
    private bool _notFound = false;
    private string? _errorMessage;

    private string _raceName = string.Empty;
    private string _eventName = string.Empty;
    private string _raceDate = string.Empty;
    private double _distanceKm;
    private DateTime? generatedAt;
    private int _splitCount;
    private int _recordCount;
    private int _regCount;
    private bool _raceStarted;

    private List<LeaderboardEntry> entries = new();
    private List<LeaderboardEntry> filteredEntries = new();
    private LeaderboardEntry? selectedEntry;

    private string _searchText = string.Empty;
    private string searchText { get => _searchText; set { _searchText = value; ApplyFilter(); } }

    protected override async Task OnParametersSetAsync() {
        _isLoading = true; _notFound = false; _errorMessage = null; entries.Clear(); filteredEntries = new List<LeaderboardEntry>();
        try {
            var race = await WithTimeout(RaceRepository.GetRaceDTOByIdAsync(RaceId), TimeSpan.FromSeconds(8));
            if (race is null) { _notFound = true; return; }
            _eventName = race.EventName ?? race.Event?.Name ?? "Evento";
            _raceName = race.RaceName ?? "Carrera";
            _raceDate = race.StartTime.ToString("dd/MM/yyyy HH:mm");
            _distanceKm = race.DistanceKm; _raceStarted = DateTime.Now >= race.StartTime;
            await LoadEntriesAsync(); ApplyFilter(); generatedAt = DateTime.Now;
        } catch (TimeoutException) { _errorMessage = "Tiempo de consulta excedido. Intenta nuevamente."; }
        catch (Exception ex) { _errorMessage = ex.Message; }
        finally { _isLoading = false; }
    }

    private void ApplyFilter() {
        if (string.IsNullOrWhiteSpace(searchText)) { filteredEntries = entries.ToList(); return; }
        var termLower = searchText.Trim().ToLowerInvariant(); int parsedBib = -1;
        if (searchText.StartsWith("#")) int.TryParse(new string(searchText.Where(char.IsDigit).ToArray()), out parsedBib);
        else if (int.TryParse(searchText, out var numeric)) parsedBib = numeric;
        filteredEntries = entries.Where(e =>
            (!string.IsNullOrEmpty(e.ParticipantName) && e.ParticipantName!.ToLowerInvariant().Contains(termLower)) ||
            (!string.IsNullOrEmpty(e.CategoryName) && e.CategoryName!.ToLowerInvariant().Contains(termLower)) ||
            (parsedBib >= 0 && e.BibNumber.HasValue && e.BibNumber.Value == parsedBib)).ToList();
    }

    private async Task LoadEntriesAsync() {
        var splits = (await WithTimeout(SplitRepository.GetByRaceIdAsync(RaceId), TimeSpan.FromSeconds(8)))?.ToList() ?? new();
        _splitCount = splits.Count;
        var registrations = (await WithTimeout(RegistrationRepository.GetByRaceIdAsync(RaceId), TimeSpan.FromSeconds(8)))?.ToList() ?? new();
        _regCount = registrations.Count;
        var finalSplit = splits.OrderByDescending(s => s.KmMark).FirstOrDefault(); if (finalSplit == null) return;
        var records = await WithTimeout(TimeRecordRepository.GetTimeRecordsByRaceAsync(RaceId), TimeSpan.FromSeconds(12));
        _recordCount = records?.Count ?? 0; if (records == null || records.Count == 0) return;
        var chipToRegistration = registrations.Where(r => r.RegistrationChips != null)
            .SelectMany(r => r.RegistrationChips!.Select(c => new { c.ChipId, Reg = r }))
            .GroupBy(x => x.ChipId).ToDictionary(g => g.Key, g => g.First().Reg);
        var groupedByChip = records.GroupBy(r => r.ChipId).ToDictionary(g => g.Key, g => g.OrderBy(x => x.Timestamp).ToList());
        foreach (var (chipId, list) in groupedByChip) {
            try {
                var finish = list.LastOrDefault(r => r.SplitId == finalSplit.SplitId); if (finish == null) continue;
                var start = list.First(); if (finish.Timestamp < start.Timestamp) continue;
                var total = finish.Timestamp - start.Timestamp;
                chipToRegistration.TryGetValue(chipId, out var reg);
                var participantName = reg?.Participant != null ? $"{reg.Participant.FirstName} {reg.Participant.LastName}".Trim() : finish.ParticipantName ?? $"Chip {chipId}";
                var categoryName = reg?.Category?.ExternalName ?? reg?.Category?.InternalName ?? "-"; var bib = reg?.BibNumber;
                var paceStr = _distanceKm > 0 ? TimingService.CalculatePace(total, _distanceKm) : "--";
                entries.Add(new LeaderboardEntry { ParticipantId = reg?.ParticipantId, ParticipantName = participantName, BibNumber = bib, CategoryName = categoryName, TotalTime = total, AveragePaceFormatted = paceStr });
            } catch { }
        }
        entries = entries.OrderBy(e => e.TotalTime).Select((e, idx) => { e.Position = idx + 1; return e; }).ToList();
    }

    private void OnRowRender(RowRenderEventArgs<LeaderboardEntry> args) {
        var classes = new List<string>{"rz-data-row","lb-row"};
        if (args.Data.Position <=3) classes.Add("podium"+args.Data.Position);
        args.Attributes["class"] = string.Join(" ", classes);
    }

    private string GetTrophyClass(int pos) => pos switch {1=>"trophy-gold",2=>"trophy-silver",3=>"trophy-bronze",_=>""};

    private async Task<T?> WithTimeout<T>(Task<T> task, TimeSpan timeout) { var delayTask = Task.Delay(timeout); var completed = await Task.WhenAny(task, delayTask); if (completed == delayTask) throw new TimeoutException(); return await task; }

    private void GoBack() => Navigation.NavigateTo("/rankings#leaderboard");
    private void Reload() => Navigation.NavigateTo(Navigation.Uri, true);

    private class LeaderboardEntry { public int Position { get; set; } public int? ParticipantId { get; set; } public string? ParticipantName { get; set; } public int? BibNumber { get; set; } public TimeSpan TotalTime { get; set; } public string TotalTimeFormatted => string.Format("{0:hh\\:mm\\:ss}", TotalTime); public string? CategoryName { get; set; } public string AveragePaceFormatted { get; set; } = "--"; }
}
