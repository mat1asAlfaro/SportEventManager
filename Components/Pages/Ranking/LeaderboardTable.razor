@* Tabla de posiciones separada del contenedor de filtros *@
<div class="table-responsive leaderboard-table mt-4">
  <table class="table table-dark table-hover align-middle">
    <thead>
      <tr>
        <th scope="col">Pos.</th>
        <th scope="col">Atleta</th>
        <th scope="col">Dorsal</th>
        <th scope="col">Tiempo</th>
        <th scope="col">Ritmo</th>
        <th scope="col">Categoría</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td colspan="6" class="text-secondary text-center py-4">
          Selecciona un evento y una carrera para ver la clasificación
        </td>
      </tr>
    </tbody>
  </table>
</div>
