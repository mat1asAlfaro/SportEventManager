@* Componente: Resultados por dorsal (búsqueda individual) *@
<div class="search-container">
  <h5 class="fw-bold mb-2">Buscar Resultados</h5>
  <p class="text-secondary mb-4">Selecciona el evento, la carrera e ingresa tu número de dorsal</p>

  <!-- Evento -->
  <div class="mb-3">
    <label class="form-label">Evento</label>
    <select class="form-select">
      <option value="" selected>Selecciona un evento</option>
    </select>
  </div>

  <!-- Carrera -->
  <div class="mb-3">
    <label class="form-label">Carrera</label>
    <select class="form-select" disabled>
      <option value="" selected>Selecciona una carrera</option>
    </select>
  </div>

  <!-- Número de Dorsal -->
  <div class="mb-3">
    <label class="form-label">Número de Dorsal</label>
    <input type="text" class="form-control" placeholder="Ej: 101" disabled />
  </div>

  <!-- Botón Buscar -->
  <button class="btn btn-primary w-100 d-flex align-items-center justify-content-center gap-2 py-2" disabled>
    <span class="material-symbols-outlined">search</span>
    <span class="fw-semibold">Buscar Resultados</span>
  </button>
</div>