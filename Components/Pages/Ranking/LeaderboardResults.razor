@using SportEventManager.Core
@using SportEventManager.DTOs
@inject IEventRepository EventRepository
@inject NavigationManager Navigation

<div class="search-container mb-0">
  <h5 class="fw-bold mb-2">Leaderboard</h5>
  <p class="text-secondary mb-4">Selecciona el evento y la carrera para ver la tabla de posiciones</p>

  <div class="mb-3">
    <label class="form-label">Evento</label>
    <select class="form-select" @onchange="OnEventChanged">
      <option value="">Selecciona un evento</option>
      @foreach (var ev in finishedEvents)
      {
        <option value="@ev.EventId">@ev.Name (@ev.EndDate.ToString("dd/MM/yyyy"))</option>
      }
    </select>
  </div>

  <div class="mb-3">
    <label class="form-label">Carrera</label>
    <select class="form-select" disabled="@(!isRaceEnabled)" @onchange="OnRaceChanged">
      <option value="">Selecciona una carrera</option>
      @if (isRaceEnabled)
      {
        foreach (var race in finishedRaces)
        {
          <option value="@race.RaceId">@race.RaceName (@race.StartTime.ToString("dd/MM/yyyy HH:mm"))</option>
        }
      }
    </select>
  </div>

  <div class="d-flex justify-content-center mt-2">
    <button class="btn btn-primary btn-lg px-5 py-3 d-inline-flex align-items-center gap-2 fw-semibold"
            disabled="@(string.IsNullOrWhiteSpace(selectedEventId) || string.IsNullOrWhiteSpace(selectedRaceId))"
            @onclick="NavigateToLeaderboard">
      <span class="material-symbols-outlined fs-4">social_leaderboard</span>
      Ver leaderboard
    </button>
  </div>
</div>

@code {
  private bool isRaceEnabled = false;
  private string? selectedEventId;
  private string? selectedRaceId;

  private List<EventDTO> finishedEvents = new();
  private List<RaceDTO> finishedRaces = new();

  protected override async Task OnInitializedAsync()
  {
    var events = await EventRepository.GetAllEventsWithRacesAndSplitsAsync();
    var now = DateTime.Now;
    finishedEvents = events
      .Where(e => e.EndDate <= now)
      .OrderByDescending(e => e.EndDate)
      .ToList();
  }

  private void OnEventChanged(ChangeEventArgs e)
  {
    selectedEventId = e.Value?.ToString();
    isRaceEnabled = !string.IsNullOrWhiteSpace(selectedEventId);
    selectedRaceId = null;

    finishedRaces.Clear();
    if (isRaceEnabled && int.TryParse(selectedEventId, out var eid))
    {
      var ev = finishedEvents.FirstOrDefault(x => x.EventId == eid);
      if (ev is not null && ev.Races is not null)
      {
        var now = DateTime.Now;
        finishedRaces = ev.Races
          .Where(r => r.StartTime <= now)
          .OrderByDescending(r => r.StartTime)
          .ToList();
      }
    }
  }

  private void OnRaceChanged(ChangeEventArgs e)
  {
    selectedRaceId = e.Value?.ToString();
  }

  private void NavigateToLeaderboard()
  {
    if (int.TryParse(selectedRaceId, out var raceId))
    {
      Navigation.NavigateTo($"/rankings/leaderboard/{raceId}");
    }
  }
}
