@page "/live"
@using Radzen
@using Radzen.Blazor
@using SportEventManager.Core
@using SportEventManager.DTOs
@using SportEventManager.Models
@rendermode InteractiveServer

@inject IRaceRepository RaceRepository
@inject NavigationManager Navigation

<PageTitle>Carreras En Vivo</PageTitle>

<div class="container-lg px-4 px-sm-5 px-lg-4">

  @* Header *@
  <div
    class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mt-3 mb-4">
    <div>
      <div class="d-flex align-items-center gap-2 mb-2">
        <span class="dot-pulse-w-3 bg-success"></span>
        <h1 class="fs-3 fw-bold text-primary mb-2">Carreras En Vivo</h1>
      </div>
      <p class="text-secondary mb-0">Monitorea el progreso de los corredores en tiempo real</p>
    </div>
  </div>

  @* Stats Cards *@
  <div class="row row-cols-1 row-cols-md-3 g-4 mb-4">
    <div class="col">
      <StatsCard Title="Carreras Activas" Value="@(liveRaces.Count.ToString() ?? "0")" Description="en curso ahora"
        Icon="bigtop_updates" IconClass="fs-5" IconColor="text-success" />
    </div>
    <div class="col">
      <StatsCard Title="Total Corredores" Value="@(totalRunners.ToString() ?? "0")" Description="corredores activos"
        Icon="earthquake" IconClass="fs-5" />
    </div>
    <div class="col">
      <StatsCard Title="Puntos de Control" Value="@(totalSplits.ToString() ?? "0")" Description="en total" Icon="flag"
        IconStyle="Outlined" IconClass="fs-5" />
    </div>
  </div>

  @* Tabla de Carreras *@
  <div class="card shadow-sm mb-4 border-0">
    <div class="card-header border-bottom-0 pb-0">
      <div class="d-flex align-items-center mb-1">
        <span class="material-symbols-outlined text-success fs-5 me-2">bigtop_updates</span>
        <h5 class="mb-0 fw-semibold text-primary fs-6">Carreras en Vivo</h5>
      </div>
    </div>

    <div class="card-body d-flex flex-wrap">
      <RadzenDataGrid @ref="racesGrid" Data="@liveRaces" TItem="RaceDTO" AllowPaging="true" PageSize="5"
        AllowSorting="false" ShowPagingSummary="true" Class="custom-data-grid-scroll">

        <Columns>
          <!-- Evento -->
          <RadzenDataGridColumn Title="Evento" Width="140px">
            <Template Context="r">
              <div class="d-flex align-items-center gap-2">
                <span>@r.EventName</span>
              </div>
            </Template>
          </RadzenDataGridColumn>

          <!-- Carrera -->
          <RadzenDataGridColumn Title="Carrera" Width="100px">
            <Template Context="r">
              <div class="d-flex align-items-center gap-2">
                <span class="fw-semibold">@r.RaceName</span>
              </div>
            </Template>
          </RadzenDataGridColumn>

          <!-- Categoría -->
          <RadzenDataGridColumn Title="Categoría" Width="180px">
            <Template Context="r">
              @if (r.RaceCategories != null && r.RaceCategories.Any())
              {
                var firstCategory = r.RaceCategories.First().Category?.ExternalName ?? "Sin nombre";
                var extraCount = r.RaceCategories.Count - 1;

                <div class="d-flex align-items-center gap-2 fw-semibold mb-1">
                  <div class="badge @GetCategoryStatusBadgeClass() small">
                    @firstCategory
                  </div>

                  @if (extraCount > 0)
                  {
                    <div class="badge @GetCategoryStatusBadgeClass() small">
                      +@extraCount
                    </div>
                  }
                </div>
              }
              else
              {
                <span class="text-muted small">Sin categorías</span>
              }
            </Template>
          </RadzenDataGridColumn>

          <!-- Distancia -->
          <RadzenDataGridColumn Title="Distancia" Width="80px">
            <Template Context="r">
              <div>@r.DistanceKm.ToString("0.##") km</div>
            </Template>
          </RadzenDataGridColumn>

          <!-- Ubicación -->
          <RadzenDataGridColumn Title="Ubicación" Width="140px">
            <Template Context="r">
              <div class="d-flex align-items-center gap-2">
                <span class="material-symbols-outlined fs-5">location_on</span>
                <div>@(r.Event?.Location ?? "Sin ubicación")</div>
              </div>
            </Template>
          </RadzenDataGridColumn>

          <!-- Participantes -->
          <RadzenDataGridColumn Title="Participantes" Width="100px">
            <Template Context="r">
              <div class="d-flex align-items-center gap-2">
                <span class="material-symbols-outlined fs-5"
                  style="color: var(--bs-success) !important;">earthquake</span>

                <span class="fw-semibold">@(r.Registrations?.Count ?? 0)</span>
              </div>
            </Template>
          </RadzenDataGridColumn>

          <!-- Puntos de Control -->
          <RadzenDataGridColumn Title="Puntos de Control" Width="120px">
            <Template Context="r">
              <div class="d-flex align-items-center gap-2">
                <span class="material-symbols-outlined fs-5">flag</span>
                <span>@(r.Splits?.Count ?? 0)</span>
              </div>
            </Template>
          </RadzenDataGridColumn>

          <!-- Acciones -->
          <RadzenDataGridColumn Title="Acciones" Width="160px">
            <Template Context="r">
              <RadzenButton Disabled="@isProcessing" Class="btn-size btn-error"
                Click="@(async () => await WatchRaceLive(r.RaceId))">
                <div class="d-flex align-items-center gap-2">
                  @* <span class="material-symbols-outlined fs-5">visibility</span> *@
                  <span class="dot-pulse-w-2 bg-danger"></span>
                  <span class="fw-bold">En Vivo</span>
                </div>
              </RadzenButton>
            </Template>
          </RadzenDataGridColumn>
        </Columns>

        <EmptyTemplate>
          <div class="d-flex flex-column justify-content-center align-items-center py-5 text-center w-100">
            <span class="material-symbols-outlined text-secondary fs-1 mb-2">flag</span>
            <h6 class="fw-semibold text-secondary mb-1">No hay carreras activas</h6>
            <p class="small mb-0">
              No se encontraron carreras en curso en este momento
            </p>
          </div>
        </EmptyTemplate>
      </RadzenDataGrid>
    </div>
  </div>
</div>

@code {
  private List<RaceDTO> liveRaces = new();
  private int totalRunners;
  private int totalSplits;
  private RadzenDataGrid<RaceDTO>? racesGrid;
  private bool isProcessing = false;

  protected override async Task OnInitializedAsync()
  {
    liveRaces = await RaceRepository.GetLiveRacing();
    totalRunners = liveRaces.Sum(r => r.Registrations?.Count ?? 0);
    totalSplits = liveRaces.Sum(r => r.Splits?.Count ?? 0);
  }

  private string GetCategoryStatusBadgeClass() => "status-badge-category";

  private async Task WatchRaceLive(int raceId)
  {
    if (isProcessing) return;
    isProcessing = true;

    Navigation.NavigateTo($"/live/race/{raceId}");
  }
}