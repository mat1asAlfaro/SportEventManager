@using SportEventManager.DTOs
@using SportEventManager.Models
@inherits LayoutComponentBase

<div class="modal fade @(IsVisible ? "show d-block" : "")" tabindex="-1" style="background-color: rgba(0, 0, 0, 0.5);">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Editar Evento</h5>
        <span class="material-symbols-outlined fs-5 ms-auto" @onclick="Close" role="button">close</span>
      </div>

      <div class="modal-body">
        <div class="mb-3">
          <label class="form-label small fw-semibold">Nombre</label>
          <input type="text" class="form-control" @bind="EditableEvent.Name" />
        </div>
        <div class="mb-3">
          <label class="form-label small fw-semibold">Descripcion</label>
          <input type="text" class="form-control" @bind="EditableEvent.Description" />
        </div>
        <div class="mb-3">
          <label class="form-label small fw-semibold">Fecha de Inicio</label>
          <input type="date" class="form-control custom-datetime" @bind="EditableEvent.StartDate"
            @bind:after="OnStartDateChanged" />
        </div>
        <div class="mb-3">
          <label class="form-label small fw-semibold">Fecha de Fin</label>
          <input type="date" class="form-control custom-datetime" @bind="EditableEvent.EndDate" min="@MinEndDate" />
        </div>
        <div class="mb-3">
          <label class="form-label small fw-semibold">Ubicación</label>
          <input type="text" class="form-control" @bind="EditableEvent.Location" />
        </div>
      </div>

      <div class="modal-footer">
        <button class="btn btn-secondary fw-semibold" @onclick="Close"><span
            class="material-symbols-outlined me-2 fs-6">cancel</span>Cancelar</button>
        <button class="btn btn-primary fw-semibold" @onclick="Save">
          <span class="material-symbols-outlined me-2 fs-6">save</span>Guardar cambios
        </button>
      </div>
    </div>
  </div>
</div>

@code {
  [Parameter] public Event EditableEvent { get; set; } = new();
  [Parameter] public EventCallback<Event> OnSave { get; set; }
  [Parameter] public EventCallback OnCancel { get; set; }

  private bool IsVisible { get; set; }
  private string MinEndDate = "";

  public void Show(EventDTO ev)
  {
    EditableEvent = new Event
    {
      EventId = ev.EventId,
      Name = ev.Name,
      Description = ev.Description,
      StartDate = ev.StartDate,
      EndDate = ev.EndDate,
      Location = ev.Location,
    };
    IsVisible = true;
    StateHasChanged();
  }

  private async Task Save()
  {
    await OnSave.InvokeAsync(EditableEvent);
    IsVisible = false;
  }

  private void OnStartDateChanged()
  {
    if (EditableEvent?.StartDate != null)
    {
      MinEndDate = EditableEvent.StartDate.AddDays(1).ToString("yyyy-MM-dd");

      if (EditableEvent.EndDate < EditableEvent.StartDate.AddDays(1))
      {
        EditableEvent.EndDate = EditableEvent.StartDate.AddDays(1);
      }
    }
  }

  private async Task Close()
  {
    IsVisible = false;
    await OnCancel.InvokeAsync();
  }
}