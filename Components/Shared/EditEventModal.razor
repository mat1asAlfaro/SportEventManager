@using SportEventManager.DTOs
@using SportEventManager.Models
@inherits LayoutComponentBase

<div class="modal fade @(IsVisible ? "show d-block" : "")" tabindex="-1" style="background-color: rgba(0, 0, 0, 0.5);">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Editar Evento</h5>
        <span class="material-symbols-outlined fs-5 ms-auto" @onclick="Close" role="button">close</span>
      </div>

      <div class="modal-body">
        <div class="mb-3">
          <label class="form-label fw-semibold">Nombre</label>
          <input type="text" class="form-control" @bind="EditableEvent.Name" />
        </div>
        <div class="mb-3">
          <label class="form-label fw-semibold">Descripcion</label>
          <input type="text" class="form-control" @bind="EditableEvent.Description" />
        </div>
        <div class="mb-3">
          <label class="form-label fw-semibold">Fecha de inicio</label>
          <input type="date" class="form-control custom-datetime" @bind="EditableEvent.StartDate" />
        </div>

        <div class="mb-3">
          <label class="form-label fw-semibold">Fecha de fin</label>
          <input type="date" class="form-control custom-datetime" @bind="EditableEvent.EndDate" />
        </div>
        <div class="mb-3">
          <label class="form-label fw-semibold">Ubicación</label>
          <input type="text" class="form-control" @bind="EditableEvent.Location" />
        </div>
      </div>

      <div class="modal-footer">
        <button class="btn btn-secondary fw-semibold" @onclick="Close">Cancelar</button>
        <button class="btn btn-primary" @onclick="Save">Guardar cambios</button>
      </div>
    </div>
  </div>
</div>

@code {
  [Parameter] public Event EditableEvent { get; set; } = new();
  [Parameter] public EventCallback<Event> OnSave { get; set; }
  [Parameter] public EventCallback OnCancel { get; set; }

  private bool IsVisible { get; set; }

  public void Show(EventDTO ev)
  {
    EditableEvent = new Event
    {
      EventId = ev.EventId,
      Name = ev.Name,
      Description = ev.Description,
      StartDate = ev.StartDate,
      EndDate = ev.EndDate,
      Location = ev.Location,
    };
    IsVisible = true;
    StateHasChanged();
  }

  private async Task Save()
  {
    await OnSave.InvokeAsync(EditableEvent);
    IsVisible = false;
  }

  private async Task Close()
  {
    IsVisible = false;
    await OnCancel.InvokeAsync();
  }
}