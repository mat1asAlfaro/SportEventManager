<div class="card stats-card border-0 shadow-sm h-100">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center mb-2">
      <h6 class="text-secondary fw-semibold mb-0">@Title</h6>
      @if (!string.IsNullOrEmpty(Icon))
      {
        <span class="material-symbols-outlined @IconColor @IconClass">@Icon</span>
      }
    </div>
    <div class="h2 fw-bold @ValueColor mb-2">@Value</div>
    <div class="text-secondary">@Description</div>
  </div>
</div>

@code {
  [Parameter] public string? Title { get; set; }
  [Parameter] public string? Value { get; set; }
  [Parameter] public string? Description { get; set; }
  [Parameter] public string? Icon { get; set; }
  [Parameter] public string? IconClass { get; set; } = "";
  [Parameter] public string? IconColor { get; set; } = "text-secondary";
  [Parameter] public string? ValueColor { get; set; } = "text-primary-color";
  [Parameter] public string IconStyle { get; set; } = "Regular";
  private string MaterialClass => IconStyle!.ToLower() switch
  {
    "outlined" => "material-icons-outlined",
    "rounded" => "material-icons-round",
    "sharp" => "material-icons-sharp",
    _ => "material-icons"
  };
}