@using SportEventManager.Models
@inherits LayoutComponentBase

<div class="modal fade @(IsVisible ? "show d-block" : "")" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Crear Nuevo Evento</h5>
        <span class="material-symbols-outlined fs-5 ms-auto" @onclick="Close" role="button">close</span>
      </div>

      <div class="modal-body">
        <div class="mb-3">
          <label class="form-label fw-semibold">Nombre del evento</label>
          <input type="text" class="form-control" @bind="newEvent.Name" />
        </div>

        <div class="mb-3">
          <label class="form-label fw-semibold">Descripción</label>
          <input type="text" class="form-control" @bind="newEvent.Description" rows="3" />
        </div>

        <div class="mb-3">
          <label class="form-label fw-semibold">Ubicación</label>
          <input type="text" class="form-control" @bind="newEvent.Location" />
        </div>

        <div class="row">
          <div class="col">
            <label class="form-label fw-semibold">Fecha Inicio</label>
            <input type="date" class="form-control custom-datetime" @bind="newEvent.StartDate"
              @bind:after="OnStartDateChanged" />
          </div>
          <div class="col">
            <label class="form-label fw-semibold">Fecha Fin</label>
            <input type="date" class="form-control custom-datetime" @bind="newEvent.EndDate" min="@MinEndDate" />
          </div>
        </div>
      </div>

      <div class="modal-footer">
        <button class="btn btn-secondary fw-semibold" @onclick="Close">
          <span class="material-symbols-outlined me-2 fs-6">cancel</span>Cancelar
        </button>
        <button class="btn btn-primary fw-semibold" @onclick="HandleSave">
          <span class="material-symbols-outlined me-2 fs-6">save</span>Guardar Evento
        </button>
      </div>
    </div>
  </div>
</div>

@code {
  private bool IsVisible { get; set; }
  private Event newEvent = new();
  private string MinEndDate = "";

  [Parameter] public EventCallback<Event> OnSave { get; set; }

  public void Show()
  {
    int nextYear = DateTime.Today.Year + 1;
    DateTime date = new DateTime(nextYear, 1, 1);
    while (date.DayOfWeek != DayOfWeek.Sunday)
    {
      date = date.AddDays(1);
    }

    newEvent = new Event
    {
      Name = $"San Fernando {DateTime.Now.Year + 1}",
      Description = "Un evento deportivo único que combina adrenalina, paisajes impresionantes y el espíritu competitivo de los participantes.",
      Location = "Punta del Este",
      StartDate = new DateTime(date.Year, date.Month, date.Day),
      EndDate = new DateTime(date.Year, date.Month, date.Day)
    };
    IsVisible = true;
    StateHasChanged();
  }

  private async Task HandleSave()
  {
    if (string.IsNullOrWhiteSpace(newEvent.Name) || string.IsNullOrWhiteSpace(newEvent.Location))
      return;

    if (OnSave.HasDelegate)
      await OnSave.InvokeAsync(newEvent);

    IsVisible = false;
  }

  private void OnStartDateChanged()
  {
    if (newEvent?.StartDate != null)
    {
      MinEndDate = newEvent.StartDate.AddDays(1).ToString("yyyy-MM-dd");

      if (newEvent.EndDate < newEvent.StartDate.AddDays(1))
      {
        newEvent.EndDate = newEvent.StartDate.AddDays(1);
      }
    }
  }

  private void Close()
  {
    IsVisible = false;
  }
}
